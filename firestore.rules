rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }
    function incoming() {
      return request.resource.data;
    }
    function isValidRSVP(data) {
      return data.keys().hasAll(['attending', 'createdAt'])
        && data.keys().size() == 2
        && data.attending is bool
        && data.createdAt == request.time;
    }
    match /rsvps/{rsvpId} {
      allow create: if isValidId(rsvpId) && isValidRSVP(incoming());
      allow list: if true;
      allow get, update, delete: if false;
    }
  }
}
